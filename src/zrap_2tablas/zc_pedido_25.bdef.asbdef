projection;
strict ( 2 );
use draft;

define behavior for ZC_PEDIDO_25 alias Pedido
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Posiciones { create; with draft; }
}

define behavior for ZC_PEDIDO_POS_25 alias Posicion
{
  use update;
  use delete;

  use association _Pedido { with draft; }
}